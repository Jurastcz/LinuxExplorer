<Window x:Class="LinuxExplorer.Views.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Height="460" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       TextWrapping="Wrap" MaxWidth="350"/>
        </StackPanel>

        <!-- Properties Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row helpers -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Path:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FullPath}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileType}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileSize}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Inode:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InodeNumber}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Permissions:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Permissions}" Style="{StaticResource ValueStyle}" FontFamily="Consolas"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Octal:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OctalPermissions}" Style="{StaticResource ValueStyle}" FontFamily="Consolas"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Owner (UID):" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Owner}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Group (GID):" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Group}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Access Time:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding AccessTime}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Change Time:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ChangeTime}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Modify Time:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ModifyTime}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Hard Links:" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding LinkCount}" Style="{StaticResource ValueStyle}"/>
            </Grid>
        </ScrollViewer>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right"
                Width="80" Margin="0,10,0,0"
                Click="CloseButton_Click"
                Style="{StaticResource PrimaryButtonStyle}"/>
    </Grid>
</Window>

<Window x:Class="LinuxExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LinuxExplorer.ViewModels"
        xmlns:conv="clr-namespace:LinuxExplorer.Converters"
        mc:Ignorable="d"
        Title="Linux Explorer" Height="700" Width="1200"
        Icon="/LinuxExplorer.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="C" Command="{Binding CopyCommand}"/>
        <KeyBinding Modifiers="Control" Key="X" Command="{Binding CutCommand}"/>
        <KeyBinding Modifiers="Control" Key="V" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
    </Window.InputBindings>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:PermissionsConverter x:Key="PermissionsConverter"/>
        <conv:FileTypeToIconConverter x:Key="FileTypeToIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Style="{StaticResource MenuBarStyle}">
            <MenuItem Header="_File">
                <MenuItem Header="_Copy to Windows" Command="{Binding CopyToWindowsCommand}"
                          IsEnabled="{Binding HasSelectedItem}"/>
                <MenuItem Header="Copy _from Windows" Command="{Binding CopyFromWindowsCommand}"
                          IsEnabled="{Binding IsWritableFilesystem}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X"
                          IsEnabled="{Binding HasSelectedItems}"/>
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C"
                          IsEnabled="{Binding HasSelectedItems}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"
                          IsEnabled="{Binding HasClipboardItems}"/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del"
                          IsEnabled="{Binding HasSelectedItems}"/>
                <MenuItem Header="Re_name" Command="{Binding RenameCommand}" InputGestureText="F2"
                          IsEnabled="{Binding HasSelectedItems}"/>
                <Separator/>
                <MenuItem Header="_Select All" Command="{Binding SelectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}"/>
                <Separator/>
                <MenuItem Header="Large _Icons" IsCheckable="True" IsChecked="{Binding IsLargeIconView}"/>
                <MenuItem Header="_Details" IsCheckable="True" IsChecked="{Binding IsDetailsView}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Properties" Command="{Binding PropertiesCommand}" IsEnabled="{Binding HasSelectedItem}"/>
                <!--<Separator/>-->
                <MenuItem Header="_Format Partition (ext2/3/4)..." Click="MenuFormatPartition_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Linux Explorer" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Style="{StaticResource ToolBarStyle}">
            <Button Command="{Binding NavigateBackCommand}" ToolTip="Back"
                    Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Button Command="{Binding NavigateForwardCommand}" ToolTip="Forward"
                    Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Button Command="{Binding NavigateUpCommand}" ToolTip="Up"
                    Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Button Command="{Binding RefreshCommand}" ToolTip="Refresh"
                    Style="{StaticResource ToolBarButtonStyle}">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Separator/>
            <!-- Path Bar -->
            <TextBox Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                     Width="400"
                     Style="{StaticResource PathBarStyle}"
                     KeyDown="PathBar_KeyDown"/>
            <Separator/>
            <Button Command="{Binding CopyToWindowsCommand}" ToolTip="Copy to Windows"
                    Style="{StaticResource ToolBarButtonStyle}"
                    IsEnabled="{Binding HasSelectedItem}">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
            <Button Command="{Binding CopyFromWindowsCommand}" ToolTip="Copy from Windows"
                    Style="{StaticResource ToolBarButtonStyle}"
                    IsEnabled="{Binding IsWritableFilesystem}">
                <TextBlock Text="&#xE8C9;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="150" MaxWidth="500"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation TreeView -->
            <TreeView Grid.Column="0"
                      ItemsSource="{Binding Disks}"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      Style="{StaticResource NavigationTreeStyle}">
                <TreeView.Resources>
                    <!-- Disk item template -->
                    <HierarchicalDataTemplate DataType="{x:Type vm:DiskViewModel}"
                                              ItemsSource="{Binding Partitions}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <!-- Partition item template -->
                    <HierarchicalDataTemplate DataType="{x:Type vm:PartitionViewModel}"
                                              ItemsSource="{Binding Directories}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <!-- Directory item template -->
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemItemViewModel}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0"
                                       Foreground="{StaticResource FolderIconBrush}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource SplitterBrush}"/>

            <!-- File List -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Loading indicator -->
                <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                           FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"/>

                <!-- Empty directory message -->
                <TextBlock Text="This folder is empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding HasItems}" Value="False"/>
                                        <Condition Binding="{Binding HasCurrentFilesystem}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- No disk selected message -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentFilesystem}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Text="Select an ext2/3/4 partition from the left panel"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="(Requires Administrator privileges)"
                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- File ListView -->
                <ListView ItemsSource="{Binding CurrentItems}"
                          SelectedItem="{Binding SelectedItem}"
                          Style="{StaticResource FileListViewStyle}"
                          MouseDoubleClick="ListView_MouseDoubleClick"
                          SelectionChanged="ListView_SelectionChanged">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy to _Windows" Command="{Binding DataContext.CopyToWindowsCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding DataContext.HasSelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Copy _from Windows" Command="{Binding DataContext.CopyFromWindowsCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding DataContext.IsWritableFilesystem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Cu_t" Command="{Binding DataContext.CutCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      InputGestureText="Ctrl+X"
                                      IsEnabled="{Binding DataContext.HasSelectedItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="_Copy" Command="{Binding DataContext.CopyCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      InputGestureText="Ctrl+C"
                                      IsEnabled="{Binding DataContext.HasSelectedItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="_Paste" Command="{Binding DataContext.PasteCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      InputGestureText="Ctrl+V"
                                      IsEnabled="{Binding DataContext.HasClipboardItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="_Delete" Command="{Binding DataContext.DeleteCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      InputGestureText="Del"
                                      IsEnabled="{Binding DataContext.HasSelectedItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Re_name" Command="{Binding DataContext.RenameCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      InputGestureText="F2"
                                      IsEnabled="{Binding DataContext.HasSelectedItems,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="New _Folder" Command="{Binding DataContext.NewFolderCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding DataContext.IsWritableFilesystem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="_Properties" Command="{Binding DataContext.PropertiesCommand,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      IsEnabled="{Binding DataContext.HasSelectedItem,
                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Margin="0,0,6,0"
                                                       Foreground="{Binding IconColor}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90"
                                            DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                            <GridViewColumn Header="Type" Width="100"
                                            DisplayMemberBinding="{Binding TypeName}"/>
                            <GridViewColumn Header="Date Modified" Width="150"
                                            DisplayMemberBinding="{Binding DateModified}"/>
                            <GridViewColumn Header="Permissions" Width="110"
                                            DisplayMemberBinding="{Binding Permissions}"/>
                            <GridViewColumn Header="Owner:Group" Width="100"
                                            DisplayMemberBinding="{Binding OwnerGroup}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusItemCount}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusFreeSpace}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusFilesystemType}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

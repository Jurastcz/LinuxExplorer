<Window x:Class="LinuxExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LinuxExplorer.ViewModels"
        xmlns:conv="clr-namespace:LinuxExplorer.Converters"
        mc:Ignorable="d"
        Title="Linux Explorer"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Disk Image..." Command="{Binding OpenDiskImageCommand}" />
                <MenuItem Header="Open Raw _Partition..." Command="{Binding OpenPartitionCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1">
            <Button Command="{Binding NavigateBackCommand}" ToolTip="Back"
                    IsEnabled="{Binding CanGoBack}">
                <TextBlock Text="&#x2190;" FontSize="14" />
            </Button>
            <Button Command="{Binding NavigateForwardCommand}" ToolTip="Forward"
                    IsEnabled="{Binding CanGoForward}">
                <TextBlock Text="&#x2192;" FontSize="14" />
            </Button>
            <Button Command="{Binding NavigateUpCommand}" ToolTip="Up">
                <TextBlock Text="&#x2191;" FontSize="14" />
            </Button>
            <Separator />
            <Button Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <TextBlock Text="&#x21BB;" FontSize="14" />
            </Button>
            <Separator />
            <Button Command="{Binding NewFolderCommand}" ToolTip="New Folder">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4C1;" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="New Folder" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding CopyToWindowsCommand}" ToolTip="Copy selected file(s) to Windows">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2B07;" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="Copy To Windows" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CopyFromWindowsCommand}" ToolTip="Copy file(s) from Windows into current directory">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2B06;" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="Copy From Windows" />
                </StackPanel>
            </Button>
            <Separator />
            <Button Command="{Binding DeleteCommand}" ToolTip="Delete selected item(s)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" FontSize="12" Margin="0,0,4,0" />
                    <TextBlock Text="Delete" />
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Address Bar -->
        <DockPanel Grid.Row="2" Margin="4,2">
            <TextBlock DockPanel.Dock="Left" Text="Address:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Go" Width="40" Margin="4,0,0,0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{Binding CurrentPath}" />
            <TextBox Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Padding="4,2" />
        </DockPanel>

        <!-- Main content area: TreeView + ListView -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="150" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: Directory Tree -->
            <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <TreeView ItemsSource="{Binding DirectoryTree}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:DirectoryItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C1;" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#E0E0E0" />

            <!-- Right: File ListView -->
            <ListView Grid.Column="2"
                      ItemsSource="{Binding CurrentFiles}"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="ListView_MouseDoubleClick"
                      SelectionChanged="ListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="100"
                                        DisplayMemberBinding="{Binding SizeDisplay}" />
                        <GridViewColumn Header="Type" Width="120"
                                        DisplayMemberBinding="{Binding FileType}" />
                        <GridViewColumn Header="Modified" Width="160"
                                        DisplayMemberBinding="{Binding LastModified}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DiskInfo}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.IsHitTestVisible>True</Grid.IsHitTestVisible>
            <Border Background="White" CornerRadius="8" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="200">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="16" Margin="0,0,0,12" />
                    <TextBlock Text="Loading..." HorizontalAlignment="Center" FontSize="14" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
